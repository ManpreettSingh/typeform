{
  "name": "typeform-clone",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/py.mjs -m uvicorn app.main:app --reload --timeout-graceful-shutdown 1 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "node scripts/py.mjs -m app.seed",
    "test:backend": "node scripts/py.mjs -m pytest -q",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "e2e:start": "node scripts/e2e-stack.mjs start",
    "e2e:stop": "node scripts/e2e-stack.mjs stop",
    "e2e:status": "node scripts/e2e-stack.mjs status",
    "test:frontend": "npm --prefix frontend run test",
    "check:frontend": "npm run test:frontend && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
