# SQLAlchemy URL; relative paths resolve from the backend/ directory
DATABASE_URL=sqlite:///./app.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# "Create with AI": a Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to disable AI.
GEMINI_API_KEY=
# Any Gemini model id; Flash-Lite is fast and cheap enough for drafting forms.
GEMINI_MODEL=gemini-3.5-flash-lite
# true: add the demo forms and responses at startup when they're missing (hosted demo). Re-running never duplicates.
SEED_DEMO_DATA=false
