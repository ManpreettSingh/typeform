# SQLAlchemy URL; relative paths resolve from the backend/ directory
DATABASE_URL=sqlite:///./app.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# "Create with AI": a Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to disable AI.
GEMINI_API_KEY=
# Any Gemini model id; Flash-Lite is fast and cheap enough for drafting forms.
GEMINI_MODEL=gemini-3.5-flash-lite
# Payment questions: Razorpay keys from the dashboard (Account & Settings -> API keys). Use TEST mode keys (rzp_test_...)
# until you go live. Leave empty to disable payments. The secret is only ever used on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# true: add the demo forms and responses at startup when they're missing (hosted demo). Re-running never duplicates.
SEED_DEMO_DATA=false
